{
  "_meta": {
    "name": "patterns_zh",
    "source": "2026 中文互联网 AI 写作特征 + 学术八股 + 翻译腔研究；词表带 alt=改写建议",
    "notes": "中文机器腔 = 黑话密度 + 八股结构 + 节奏均匀；学术八股人写论文也有，故权重偏低、看密度不看单点。"
  },
  "model_artifacts": [
    {
      "pattern": "oaicite|turn0search[0-9]+|contentreference",
      "desc": "ChatGPT 引用残留"
    }
  ],
  "chatbot_artifacts": [
    {
      "pattern": "作为一个?(人工智能|AI语言模型|大语言模型)",
      "desc": "AI 自我声明"
    },
    {
      "pattern": "我是(一个)?(AI|人工智能|语言模型)",
      "desc": "AI 自我声明"
    },
    {
      "pattern": "希望(以上|这些|本)内容?(对您|对你|对大家)(有所|有)?帮助",
      "desc": "客服式收尾"
    },
    {
      "pattern": "如果(您|你)还有(其他|任何)(问题|疑问)",
      "desc": "客服式收尾"
    },
    {
      "pattern": "(请问)?还有什么(可以|能)(帮|帮助|协助)(到)?(您|你)",
      "desc": "客服式收尾"
    },
    {
      "pattern": "以下是(为您|为你)(生成|撰写|整理|改写)的",
      "desc": "交付式开场"
    },
    {
      "pattern": "好的[，,]?(以下是|我(来|将))",
      "desc": "对话残留"
    },
    {
      "pattern": "(根据|按照)(我|您|你)(的)?(要求|指令|提示)(，|,)?(我)?(已经|已)?(为您|为你)?(完成|生成|撰写)",
      "desc": "对话残留"
    },
    {
      "pattern": "根据我的训练数据",
      "desc": "训练数据声明"
    },
    {
      "pattern": "(截至|截止)(我的)?(知识|训练).{0,6}(更新|截止|日期)",
      "desc": "知识截止声明"
    },
    {
      "pattern": "我所掌握的信息(截止|截至|可能)",
      "desc": "知识截止声明"
    },
    {
      "pattern": "(我|本)(无法|不能)(获取|访问)(实时|最新)(数据|信息)",
      "desc": "能力声明"
    },
    {
      "pattern": "(以上|本文)内容(仅供参考|不构成.{0,8}建议)",
      "desc": "免责模板"
    },
    {
      "pattern": "如需(任何|进一步)?(修改|调整|帮助|协助|优化)，?请(随时|立即)?(告诉我|告知|联系|留言)",
      "desc": "客服式收尾"
    },
    {
      "pattern": "(如果|若)(您|你)(还)?(需要|有)(任何)?(其他)?(问题|需求|帮助)，?(请|欢迎)",
      "desc": "客服式收尾"
    }
  ],
  "knowledge_cutoff": [
    {
      "pattern": "(截至|截止)(目前|现在)，?我的(知识|数据|信息)",
      "desc": "知识截止"
    }
  ],
