  "regex_signals": [
    {
      "cat": "zh_eightleg",
      "label": "学术八股（人写也有，看密度）",
      "weight": 0.4,
      "pattern": "综上所述|值得注意的是|值得一提(的)?是|不难发现|由此可见|众所周知|具有重要意义|具有重要(的)?(理论|实践|现实|临床)?意义|提供了新的(思路|视角|途径|方向)|奠定了(坚实)?(的)?基础|为.{2,14}提供了(新|有益|重要|宝贵)(的)?(思路|参考|借鉴|启示|依据|经验)|发挥着(越来越)?(重要|关键)?(的)?作用|起着?举足轻重(的)?(作用|地位)|应用前景(广阔|广泛)|前景广阔|取得了(显著|长足)(的)?(进展|成效)|日益(增长|凸显|受到)|随着.{2,16}的(快速|迅速|不断|日益|深入)发展",
      "show_hits": true
    },
    {
      "cat": "zh_eightleg",
      "label": "公文式动词结构（进行了…分析）",
      "weight": 0.5,
      "pattern": "进行(了|了)?(一次|一番|逐步)?(深入|系统|全面|详细|细致)?(的)?(分析|研究|探讨|论述|讨论|评估|考察|总结|梳理)",
      "show_hits": true
    },
    {"cat": "zh_opening", "label": "篇章级模板开局", "weight": 1.0,
     "pattern": "本文(基于|从|旨在|将)|本综述(基于|旨在|将)|旨在为.{2,8}(提供|总结)|本文从.{2,8}(视角|角度)",
     "show_hits": true},
    {
      "cat": "zh_jargon_struct",
      "label": "排比/对仗结构（不仅…而且 / 一方面…另一方面）",
      "weight": 0.7,
      "pattern": "一方面[，、].{4,90}另一方面|不仅.{2,40}(，而且|，更|，还)|首先.{4,80}其次.{4,80}(最后|再次|然后)",
      "show_hits": false
    },
    {
      "cat": "zh_trans",
      "label": "翻译腔/空泛过渡",
      "weight": 0.5,
      "pattern": "被广泛(认为|接受|使用)|在(很大|相当|某种)程度上|基于(以上|上述)(原因|考虑)|总而言之|总的来说|与此同时|事实上[，,]|无疑[，,]|毫无疑问[，,]|众所周知[，,]",
      "show_hits": true
    },
    {
      "cat": "zh_punct",
      "label": "半角标点（中文语境应为全角）",
      "weight": 0.3,
      "pattern": "(?<=[一-鿿])[,;:?!](?=[一-鿿]|$)|(?<=[A-Za-z0-9])[,;](?=[一-鿿])|(?<=[一-鿿])\\.(?=[一-鿿]|$|\\s)",
      "show_hits": false
    },
    {
      "cat": "markdown",
      "label": "Markdown 残留（纯文本语境）",
      "weight": 0.8,
      "pattern": "\\*\\*[^*\\n]{2,60}\\*\\*|==[^=\\n]{2,40}==|(?m:^#{1,6} \\S)",
      "show_hits": true
    }
  ],
  "auto_fixes": [
    {
      "pattern": "(?<=[\\u4e00-\\u9fff])\\s*,\\s*(?=[\\u4e00-\\u9fff]|$|[0-9])",
      "replacement": "，",
      "note": "半角逗号→全角"
    },
    {
      "pattern": "(?<=[A-Za-z0-9])\\s*,\\s*(?=[\\u4e00-\\u9fff])",
      "replacement": "，",
      "note": "半角逗号→全角（数字/字母后接中文）"
    },
    {
      "pattern": "(?<=[\\u4e00-\\u9fff])\\s*;\\s*(?=[\\u4e00-\\u9fff]|$)",
      "replacement": "；",
      "note": "半角分号→全角"
    },
    {
      "pattern": "(?<=[A-Za-z0-9])\\s*;\\s*(?=[\\u4e00-\\u9fff])",
      "replacement": "；",
      "note": "半角分号→全角（kPa;行 场景）"
    },
    {
      "pattern": "(?<=[\\u4e00-\\u9fff]):(?=[\\u4e00-\\u9fff]|$|\\s)",
      "replacement": "：",
      "note": "半角冒号→全角"
    },
    {
      "pattern": "(?<=[\\u4e00-\\u9fff])\\?(?=[\\u4e00-\\u9fff]|$|\\s)",
      "replacement": "？",
      "note": "半角问号→全角"
    },
    {
      "pattern": "(?<=[\\u4e00-\\u9fff])!(?=[\\u4e00-\\u9fff]|$|\\s)",
      "replacement": "！",
      "note": "半角叹号→全角"
    },
    {
      "pattern": "(?<=[\\u4e00-\\u9fff])\\.(?=[\\u4e00-\\u9fff]|$|\\s)",
      "replacement": "。",
      "note": "半角句号→全角（小数点不受影响）"
    },
    {
      "pattern": "\\s+，",
      "replacement": "，",
      "note": "行内残留清除后的悬挂空格"
    },
    {
      "pattern": "的的",
      "replacement": "的",
      "note": "重复「的」"
    },
    {
      "pattern": "(?<=[\\u4e00-\\u9fff]) {2,}(?=[\\u4e00-\\u9fff])",
      "replacement": "",
      "note": "汉字间多余空格"
    },
    {
      "pattern": "\\*\\*([^*\\n]+)\\*\\*",
      "replacement": "\\1",
      "note": "去加粗"
    }
  ],
  "aggressive_fixes": [],
  "curly_quote_fix": false,
  "_filler_note": "中文深改（黑话替换、八股拆解、节奏重排）不自动执行——交给 agent 按 references/style_guide_zh.md 处理，脚本只做确定性机械修复。"
}