  "regex_signals": [
    {
      "cat": "en_inflation",
      "label": "意义拔高（significance inflation）",
      "weight": 1.2,
      "pattern": "serves? as a testament to|stands? as a testament|pivotal (moment|role)|indelible mark|underscor(e|es|ing) (the|its) (importance|significance)|cannot be overstated|marks? a significant milestone|a new era of|in the annals of|shed(s|ding)? light on the intricate|rich (cultural )?heritage",
      "show_hits": true
    },
    {
      "cat": "en_copula",
      "label": "系动词回避（serves as / stands as）",
      "weight": 0.6,
      "pattern": "\\b(serves?|served) as (a|an|the)\\b|\\b(stands?|stood) as (a|an|the)\\b|\\brepresents? a (significant|notable|key|powerful)",
      "show_hits": true
    },
    {
      "cat": "en_promo",
      "label": "宣传腔（promotional tone）",
      "weight": 0.9,
      "pattern": "\\bnestled\\b|in the heart of|breathtaking|stunning views|must-see|hidden gem|pristine|picturesque|vibrant (culture|community|city|atmosphere)|diverse array|wide (range|array) of (options|services|products)|state-of-the-art (facilities|amenities)|cutting-?edge (technology|solutions)",
      "show_hits": true
    },
    {
      "cat": "en_vague",
      "label": "模糊归因（vague attribution）",
      "weight": 0.9,
      "pattern": "(experts|critics|observers|researchers) (say|said|argue|argued|believe|note|notes|suggest)|industry reports (say|suggest|indicate)|it is widely (believed|accepted|regarded)|many (believe|argue|consider)|some (argue|believe|suggest)|sources (say|suggest|close to)",
      "show_hits": true
    },
    {
      "cat": "en_ing",
      "label": "表层 -ing 尾挂（superficial -ing）",
      "weight": 0.7,
      "pattern": ",? (highlighting|underscoring|reflecting|emphasizing|demonstrating|illustrating|contributing to|reinforcing|signaling) (the|its|their)\\b|providing (valuable )?insights into|offering a (glimpse|window) into|paving the way for",
      "show_hits": true
    },
    {
      "cat": "en_para",
      "label": "负向平行句（not only…but also）",
      "weight": 0.8,
      "pattern": "not only .{3,60},? but also|not just .{3,60},? but |it('s| is) not (just|only|merely) about.{2,40},? it('s| is) about|rather than (a|an|merely) .{3,40},? it is",
      "show_hits": true
    },
    {
      "cat": "en_chal",
      "label": "挑战/展望公式段（challenges formula）",
      "weight": 0.9,
      "pattern": "[Dd]espite (these|the|its) (challenges|obstacles|hurdles)|[Ff]uture (outlook|prospects) (look|appear|seem)|[Oo]nly time will tell|[Tt]he future of .{2,30} (looks|appears|seems) (bright|promising)|[Aa]s .{2,30} continues to (evolve|grow|develop)",
      "show_hits": true
    },
    {
      "cat": "en_filler",
      "label": "填充短语（filler phrases）",
      "weight": 0.6,
      "pattern": "in order to\\b|due to the fact that|it is (important|worth) (to note|noting) that\\b|in today'?s (fast-?paced |modern |digital )?world|in the (digital age|realm of)|when it comes to\\b|at the end of the day|plays? a (crucial|vital|key|significant) role in",
      "show_hits": true
    },
    {
      "cat": "markdown",
      "label": "Markdown 残留（纯文本语境）",
      "weight": 0.8,
      "pattern": "^#{1,6} \\S|\\*\\*[^*\\n]{2,60}\\*\\*|^[-*] \\[ \\] |==[^=\\n]{2,40}==",
      "show_hits": true
    },
    {
      "cat": "en_opening",
      "label": "万能框架（canned openers: ever-evolving, navigating the complexities…）",
      "weight": 0.8,
      "show_hits": true,
      "pattern": "in the ever-(evolving|changing|expanding) (world|landscape|realm|field) of|embark(s|ed|ing)? on (a|the|an) (journey|exploration)|(dive|diving|delves?|delving) into the (world|realm) of"
    }
  ],
